[gd_resource type="Theme" format=3]

; Tema global Supernova. Dipasang di Project Settings > GUI > Theme > Custom,
; jadi SEMUA Label di game & menu otomatis pakai font + ukuran ini.
;
; Font pixel: seret file .ttf/.otf ke slot "Default Font" di Inspector
; (klik file ini di FileSystem). Selama kosong, Godot pakai font bawaan.
;
; Ukuran font (ubah di sini, bukan di tiap Label):
;   TitleLabel = judul besar (SUPERNOVA, GAME OVER)
;   HudLabel   = HP, ammo, skor, chain, hasil game over
;   BodyLabel  = status ability, teks menu biasa
;   SmallLabel = kontrol, kredit, teks kecil

[sub_resource type="StyleBoxFlat" id="btn_normal"]
bg_color = Color(0.11, 0.11, 0.2, 0.92)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.29, 0.282, 0.388, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
content_margin_left = 26.0
content_margin_top = 10.0
content_margin_right = 26.0
content_margin_bottom = 10.0

[sub_resource type="StyleBoxFlat" id="btn_hover"]
bg_color = Color(0.18, 0.17, 0.3, 0.98)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.937, 0.624, 0.153, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
content_margin_left = 26.0
content_margin_top = 10.0
content_margin_right = 26.0
content_margin_bottom = 10.0

[sub_resource type="StyleBoxFlat" id="btn_pressed"]
bg_color = Color(0.07, 0.07, 0.13, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.937, 0.624, 0.153, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
content_margin_left = 26.0
content_margin_top = 10.0
content_margin_right = 26.0
content_margin_bottom = 10.0

[resource]
default_font_size = 20
TitleLabel/base_type = &"Label"
TitleLabel/font_sizes/font_size = 52
HudLabel/base_type = &"Label"
HudLabel/font_sizes/font_size = 24
BodyLabel/base_type = &"Label"
BodyLabel/font_sizes/font_size = 20
SmallLabel/base_type = &"Label"
SmallLabel/font_sizes/font_size = 14
Button/font_sizes/font_size = 22
Button/colors/font_color = Color(0.91, 0.925, 1, 1)
Button/colors/font_hover_color = Color(0.937, 0.624, 0.153, 1)
Button/colors/font_pressed_color = Color(1, 0.85, 0.5, 1)
Button/colors/font_focus_color = Color(0.91, 0.925, 1, 1)
Button/colors/font_disabled_color = Color(0.45, 0.45, 0.5, 1)
Button/styles/normal = SubResource("btn_normal")
Button/styles/hover = SubResource("btn_hover")
Button/styles/pressed = SubResource("btn_pressed")
Button/styles/focus = SubResource("btn_hover")
Button/styles/disabled = SubResource("btn_normal")
